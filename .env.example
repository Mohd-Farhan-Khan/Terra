# Required in local, Preview, and Production environments.
# Find both values in Supabase: Project Settings -> API (or Connect).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Do not add SUPABASE_SERVICE_ROLE_KEY here or to Vercel. Terra only uses the
# public publishable key; user access is enforced by Supabase Row-Level Security.
